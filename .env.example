# Copy to .env and fill in real values.
# NEVER commit .env to version control.
#
# Docker note: DATABASE_URL must use host.docker.internal (not localhost)
# when the backend runs in a container on the VPS.
# Example: postgres://madar:<password>@host.docker.internal:5432/madar

DATABASE_URL=postgres://madar:<password>@host.docker.internal:5432/madar

# Local dev only (docker-compose.dev.yml overrides DATABASE_URL with this):
DEV_DATABASE_URL=postgres://madar:<password>@host.docker.internal:5432/madar_dev

# Must be a long random string — generate with: openssl rand -hex 32
JWT_SECRET=<generate-with-openssl-rand-hex-32>

RUST_LOG=info
BIND_ADDR=0.0.0.0:8081
UPLOADS_DIR=./uploads
# The apex serves static files only — it does NOT proxy /api/, whatever this
# line used to imply. Uploads are reached through the API's own host.
UPLOADS_BASE_URL=https://api.madar-pos.cloud/uploads
# Content-addressed assets (<org_id>/<sha256>.<ext>). Default ${UPLOADS_DIR}/assets.
ASSETS_DIR=./uploads/assets
# REQUIRED in production: HMAC key for signed org-scoped asset URLs (>= 32 bytes,
# generate with: openssl rand -hex 32). A release build refuses to start (before
# running migrations) when it is missing or short.
ASSET_URL_SECRET=<generate-with-openssl-rand-hex-32>
# REQUIRED in production: HMAC key for the PIN fingerprint that lets a PIN be
# looked up instead of scanned (>= 32 bytes, openssl rand -hex 32). It must live
# HERE and never in the database — a stolen database cannot be tested against
# without it. A release build refuses to start without it.
MADAR_PIN_FINGERPRINT_KEY=<generate-with-openssl-rand-hex-32>
# While rotating that key, keep the previous one readable for a grace period:
# lookups try both, and each sign-in re-stamps the row under the current key.
# MADAR_PIN_FINGERPRINT_KEY_OLD=
# Ed25519 seed (64 hex chars) that signs the offline permission snapshots tablets
# verify. Not boot-required: without it a release answers 503 on
# GET /devices/me/authz-snapshot. Generate: openssl rand -hex 32
MADAR_AUTHZ_SIGNING_KEY=<generate-with-openssl-rand-hex-32>
# While rotating, keep the previous seed so its public key is still published:
# MADAR_AUTHZ_SIGNING_KEY_OLD=
# Public API origin used to make asset URLs absolute (optional; relative if unset).
# API_PUBLIC_URL=https://api.madar-pos.cloud
# Heavy image/zstd work runs in a background worker; keep 1 on a small VPS.
ASSET_WORKER_CONCURRENCY=1
# Recipe-step animations. Shipped inside the image; served at /static/step-animations.
STEP_ANIMATIONS_DIR=./static/step-animations

# WhatsApp gateway (container-network address set by docker-compose.yml;
# WHATSAPP_AUTH_HEADER must match WA_AUTH_TOKEN in the whatsapp container)
WHATSAPP_AUTH_HEADER=<shared-secret>
WHATSAPP_SESSION=main

# App Review sign-in (the Dawam staff app). Apple's reviewers can't receive the
# WhatsApp code, so with BOTH of these set, a sign-in code asked for exactly
# MADAR_REVIEW_PHONE is MADAR_REVIEW_OTP (six digits) and no WhatsApp is sent.
# Everything else is the ordinary sign-in: the phone must belong to an active
# employee with app access in a Dawam business, one code a minute, five tries,
# the code is used once, the phone is bound, the location notice is asked for.
# Off when either is unset (or the code is not six digits). While it is on the
# server logs a warning at boot, never the code. Unset both after the review.
# MADAR_REVIEW_PHONE=+2010xxxxxxxx
# MADAR_REVIEW_OTP=<six digits>

# Shlink short-URL service (SHLINK_BASE_URL overridden by compose to http://shlink:8080;
# SHLINK_API_KEY is also used by the Shlink container as INITIAL_API_KEY)
SHLINK_API_KEY=<your-shlink-api-key>

# Origins of the two PUBLIC apps. These are separately built, separately
# deployed bundles on their own hosts — NOT paths under the dashboard. The apex
# domain serves the dashboard SPA, which has no `/order/{org}` route at all, so
# pointing either of these at it produces QR cards and WhatsApp links that land
# on a blank page. Check these against what nginx actually serves.
#
#   PUBLIC_ORDER_BASE_URL        -> ordering + delivery tracking (QR cards)
#   PUBLIC_RESERVATIONS_BASE_URL -> table bookings (QR cards + the guest's
#                                   manage link in WhatsApp confirmations;
#                                   unset drops the link from the message and
#                                   503s the booking QR endpoints)
PUBLIC_ORDER_BASE_URL=https://order.madar-pos.cloud
PUBLIC_RESERVATIONS_BASE_URL=https://reservations.madar-pos.cloud
# The shop links page for a shop WITHOUT its own hostname
# (`{PUBLIC_LINKS_BASE_URL}/{org_id}`). A branded shop's page is the root of
# its own host and does not use this. Unset: such shops have no links-page
# address yet (the editor says so, the links QR endpoint 503s).
PUBLIC_LINKS_BASE_URL=https://links.madar-pos.cloud

# Translation (optional — leave blank to disable auto-translation)
GOOGLE_TRANSLATE_API_KEY=
SUPPORTED_LANGUAGES=en,ar

# PRODUCTION: keep false. Swagger UI exposes the full API surface unauthenticated.
MADAR_ENABLE_SWAGGER_UI=false

# ── AI analytics chat (the "Ask" module) ────────────────────────────────────
# Which LLM backend to use: "gemini" or "groq". Leave blank to auto-pick
# whichever key below is set (Gemini first). An explicit value with a missing
# key just disables the feature — no silent fallback.
AI_PROVIDER=gemini
# Gemini 2.5 Flash (Google AI Studio key).
GEMINI_API_KEY=
# Groq (OpenAI-compatible, runs Llama et al. very fast). Model is optional.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Error reporting (self-hosted Sentry) ────────────────────────────────────
# Leave SENTRY_DSN blank to disable entirely: no client is created, nothing is
# sent, and the server behaves exactly as it did before Sentry existed (the
# normal state for dev, CI, and the fuzz/load harnesses).
# Request bodies, cookies, query strings and any field matching the PII
# denylist in src/observability.rs are stripped before an event leaves the
# process — see the published privacy policy.
SENTRY_DSN=
# Defaults to "production" when blank; set to "staging"/"dev" on other boxes so
# their events do not land in the production issue stream.
SENTRY_ENVIRONMENT=
# Defaults to madar-rust@<crate version>. Set to the deployed git SHA/tag if you
# want per-deploy issue grouping and regression detection.
SENTRY_RELEASE=
# Performance tracing, 0.0–1.0. Off by default: the Sentry instance shares the
# VPS with Postgres and the backend.
SENTRY_TRACES_SAMPLE_RATE=0.0

# ── Push notifications (Dawam, APP-6) ────────────────────────────────────────
# Absolute path to the Firebase service-account JSON for the `dawam-by-madar`
# project. Push is OFF when this is unset. The file is a CREDENTIAL: keep it
# outside every repo (these are public), readable only by the service user.
# In production it sits in /etc/madar/secrets on the host, which docker-compose
# mounts at /run/secrets — so give the CONTAINER path:
#   FCM_SERVICE_ACCOUNT_FILE=/run/secrets/dawam-fcm.json
FCM_SERVICE_ACCOUNT_FILE=

# ── Rate limits ───────────────────────────────────────────────────────────────
# Every limiter is set here; a missing, unparsable or out-of-range value uses the
# default shown. MADAR_DISABLE_RATE_LIMIT=1 turns them ALL off (fuzzing/E2E only;
# never in production). Defaults doubled on the owner's request, 2026-09-25.
# General bucket, per signed-in person (a staff-app phone: per device), else per IP.
# MADAR_RATE_LIMIT_PER_MINUTE=400
# Ceiling for one IP across every account behind it.
# MADAR_RATE_LIMIT_PER_ADDRESS_PER_MINUTE=20000
# Whole-dataset exports (X-Madar-Export) per person per minute.
# MADAR_EXPORT_MAX_PER_MINUTE=10
# Per-route governors: BURST requests at once, then one more every MS_PER_REQUEST.
# AUTH/LOGIN — per IP: password/PIN login, staff OTP request + verify, staff session refresh
# MADAR_RL_AUTH_LOGIN_BURST=120
# MADAR_RL_AUTH_LOGIN_MS_PER_REQUEST=500
# AUTH/ACTIVATION — per IP: device activation codes and branch resolution
# MADAR_RL_AUTH_ACTIVATION_BURST=20
# MADAR_RL_AUTH_ACTIVATION_MS_PER_REQUEST=3000
# CUSTOMERS/BROWSE — per IP: opening the order-now page from a card
# MADAR_RL_CUSTOMERS_BROWSE_BURST=60
# MADAR_RL_CUSTOMERS_BROWSE_MS_PER_REQUEST=500
# CUSTOMERS/IDENTITY — per IP: changing who an order-now profile belongs to
# MADAR_RL_CUSTOMERS_IDENTITY_BURST=10
# MADAR_RL_CUSTOMERS_IDENTITY_MS_PER_REQUEST=3000
# CUSTOMERS/BROWSE_TOKEN — per card token: opening the order-now page
# MADAR_RL_CUSTOMERS_BROWSE_TOKEN_BURST=40
# MADAR_RL_CUSTOMERS_BROWSE_TOKEN_MS_PER_REQUEST=1000
# CUSTOMERS/IDENTITY_TOKEN — per card token: replace/combine identity
# MADAR_RL_CUSTOMERS_IDENTITY_TOKEN_BURST=6
# MADAR_RL_CUSTOMERS_IDENTITY_TOKEN_MS_PER_REQUEST=60000
# LOYALTY/BROWSE — per IP: loyalty join pages and cards
# MADAR_RL_LOYALTY_BROWSE_BURST=60
# MADAR_RL_LOYALTY_BROWSE_MS_PER_REQUEST=500
# LOYALTY/JOIN — per IP: loyalty sign-up
# MADAR_RL_LOYALTY_JOIN_BURST=10
# MADAR_RL_LOYALTY_JOIN_MS_PER_REQUEST=3000
# DEMO/REQUEST — per IP: the public demo request form
# MADAR_RL_DEMO_REQUEST_BURST=10
# MADAR_RL_DEMO_REQUEST_MS_PER_REQUEST=15000
# TICKETS/TABLE_BROWSE — per IP: a table's QR menu
# MADAR_RL_TICKETS_TABLE_BROWSE_BURST=60
# MADAR_RL_TICKETS_TABLE_BROWSE_MS_PER_REQUEST=500
# TICKETS/TABLE_INTAKE — per IP: orders placed from a table's QR
# MADAR_RL_TICKETS_TABLE_INTAKE_BURST=20
# MADAR_RL_TICKETS_TABLE_INTAKE_MS_PER_REQUEST=3000
# INTEGRATIONS/PARTNER — per IP: the password-authenticated partner analytics API
# MADAR_RL_INTEGRATIONS_PARTNER_BURST=60
# MADAR_RL_INTEGRATIONS_PARTNER_MS_PER_REQUEST=1000
# DELIVERY/BROWSE — per IP: the public delivery menu
# MADAR_RL_DELIVERY_BROWSE_BURST=60
# MADAR_RL_DELIVERY_BROWSE_MS_PER_REQUEST=500
# DELIVERY/QUOTE — per IP: delivery quotes
# MADAR_RL_DELIVERY_QUOTE_BURST=20
# MADAR_RL_DELIVERY_QUOTE_MS_PER_REQUEST=3000
# DELIVERY/OTP — per IP: delivery OTP send and verify
# MADAR_RL_DELIVERY_OTP_BURST=6
# MADAR_RL_DELIVERY_OTP_MS_PER_REQUEST=15000
# DELIVERY/INTAKE — per IP: delivery order intake
# MADAR_RL_DELIVERY_INTAKE_BURST=20
# MADAR_RL_DELIVERY_INTAKE_MS_PER_REQUEST=3000
# BOOKINGS/BROWSE — per IP: public booking pages and availability
# MADAR_RL_BOOKINGS_BROWSE_BURST=120
# MADAR_RL_BOOKINGS_BROWSE_MS_PER_REQUEST=500
# BOOKINGS/WRITE — per IP: creating or changing a public booking
# MADAR_RL_BOOKINGS_WRITE_BURST=20
# MADAR_RL_BOOKINGS_WRITE_MS_PER_REQUEST=3000
