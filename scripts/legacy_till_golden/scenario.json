{
  "_doc": "Scripted request sequence for the legacy till goldens. Run by capture.py against the OLD backend (097a653) on seed.sql, and replayed step by step by src/tills/legacy_tests.rs against the current backend. {{var}} = seed/fixed ids or values bound from an earlier response via `bind` (dot path). Steps with `save` write tests/fixtures/legacy_till_api/<save>.json.",
  "vars": {
    "org": "10000000-0000-4000-8000-000000000001",
    "branch_a": "10000000-0000-4000-8000-0000000000a1",
    "branch_b": "10000000-0000-4000-8000-0000000000b1",
    "branch_c": "10000000-0000-4000-8000-0000000000c1",
    "admin": "10000000-0000-4000-8000-00000000ad01",
    "teller_a": "10000000-0000-4000-8000-00000000ee0a",
    "teller_b": "10000000-0000-4000-8000-00000000ee0b",
    "waiter": "10000000-0000-4000-8000-00000000aa01",
    "item": "10000000-0000-4000-8000-0000000e0001",
    "s_closed": "20000000-0000-4000-8000-0000000000c1",
    "s_a": "20000000-0000-4000-8000-0000000000a1",
    "s_b": "20000000-0000-4000-8000-0000000000b1",
    "s_force": "20000000-0000-4000-8000-0000000000f1",
    "s_new": "20000000-0000-4000-8000-0000000000e1",
    "cm_setup": "30000000-0000-4000-8000-000000000001",
    "cm_ref": "30000000-0000-4000-8000-000000000002",
    "key_o1": "40000000-0000-4000-8000-000000000001",
    "key_o2": "40000000-0000-4000-8000-000000000002",
    "key_replay": "40000000-0000-4000-8000-000000000003",
    "refund_ref": "50000000-0000-4000-8000-000000000001",
    "settle_ref": "50000000-0000-4000-8000-000000000002"
  },
  "steps": [
    {"method": "POST", "path": "/shifts/branches/{{branch_a}}/open", "as": "teller_a", "expect": 201,
     "body": {"id": "{{s_closed}}", "opening_cash": 0}},
    {"method": "POST", "path": "/shifts/{{s_closed}}/cash-movements", "as": "teller_a", "expect": 201,
     "body": {"amount": 2000, "note": "float", "kind": "pay_in", "client_ref": "{{cm_setup}}"}},
    {"method": "POST", "path": "/shifts/{{s_closed}}/close", "as": "teller_a", "expect": 200,
     "body": {"closing_cash_declared": 2000, "cash_note": null}},
    {"method": "POST", "path": "/shifts/branches/{{branch_a}}/open", "as": "teller_a", "expect": 201,
     "body": {"id": "{{s_a}}", "opening_cash": 2000}},
    {"method": "POST", "path": "/shifts/branches/{{branch_b}}/open", "as": "teller_b", "expect": 201,
     "body": {"id": "{{s_b}}", "opening_cash": 1000}},
    {"method": "POST", "path": "/shifts/branches/{{branch_c}}/open", "as": "admin", "expect": 201,
     "body": {"id": "{{s_force}}", "opening_cash": 0}},
    {"method": "POST", "path": "/shifts/{{s_a}}/cash-movements", "as": "teller_a", "expect": 201,
     "body": {"amount": 500, "note": "coins", "kind": "pay_in"}},
    {"method": "POST", "path": "/orders", "as": "teller_a", "expect": 201, "bind": {"order_a": "id"},
     "body": {"branch_id": "{{branch_a}}", "shift_id": "{{s_a}}", "payment_method": "cash", "idempotency_key": "{{key_o1}}",
              "items": [{"menu_item_id": "{{item}}", "quantity": 2, "unit_price": 5000, "addons": [], "optional_field_ids": []}],
              "subtotal": 10000, "tax_amount": 0, "total_amount": 10000, "amount_tendered": 10000, "change_given": 0}},
    {"method": "POST", "path": "/orders", "as": "teller_a", "expect": 201, "bind": {"order_b": "id"},
     "body": {"branch_id": "{{branch_a}}", "shift_id": "{{s_a}}", "payment_method": "card", "idempotency_key": "{{key_o2}}",
              "items": [{"menu_item_id": "{{item}}", "quantity": 1, "unit_price": 5000, "addons": [], "optional_field_ids": []}],
              "subtotal": 5000, "tax_amount": 0, "total_amount": 5000}},
    {"method": "POST", "path": "/open-tickets", "as": "waiter", "expect": 201, "bind": {"ticket_settled": "id"},
     "body": {"branch_id": "{{branch_a}}", "guest_count": 2, "items": [{"menu_item_id": "{{item}}", "quantity": 1}]}},
    {"method": "POST", "path": "/sync/replay", "as": "teller_a", "expect": 200,
     "body": {"op": "settle_open_ticket", "teller_id": "{{teller_a}}", "ticket_id": "{{ticket_settled}}",
              "request": {"payment_method": "cash", "shift_id": "{{s_a}}"}}},
    {"method": "POST", "path": "/open-tickets", "as": "waiter", "expect": 201, "bind": {"ticket_open": "id"},
     "body": {"branch_id": "{{branch_b}}", "guest_count": 3, "items": [{"menu_item_id": "{{item}}", "quantity": 2}]}},
    {"method": "POST", "path": "/public/delivery-orders", "as": null, "expect": 201, "bind": {"delivery": "id"},
     "body": {"branch_id": "{{branch_b}}", "channel": "in_mall", "customer_name": "Golden Guest", "customer_phone": "01000000000",
              "place_name": "Shop 12", "floor": "2", "unit_number": "B4", "address_line": "12 Main St",
              "customer_lat": 30.0, "customer_lng": 31.0, "payment_method_hint": "cash", "device_token": "{{device_token}}",
              "items": [{"menu_item_id": "{{item}}", "quantity": 1}]}},

    {"save": "shifts_current", "model": "ShiftPreFill", "method": "GET", "path": "/shifts/branches/{{branch_a}}/current", "as": "teller_a"},
    {"save": "shifts_list_branch", "model": "PaginatedShifts", "method": "GET", "path": "/shifts/branches/{{branch_a}}?page=1&per_page=3", "as": "teller_a"},
    {"save": "shifts_get_open", "model": "Shift", "clients": [], "method": "GET", "path": "/shifts/{{s_a}}", "as": "admin"},
    {"save": "shifts_report_open", "model": "ShiftReportResponse", "method": "GET", "path": "/shifts/{{s_a}}/report", "as": "teller_a"},
    {"save": "shifts_report_closed", "model": "ShiftReportResponse", "method": "GET", "path": "/shifts/{{s_closed}}/report", "as": "admin"},
    {"save": "shifts_cash_movements", "model": "Vec<CashMovement>", "method": "GET", "path": "/shifts/{{s_a}}/cash-movements", "as": "teller_a"},
    {"save": "tills_list", "model": "Vec<Till>", "method": "GET", "path": "/tills?branch_id={{branch_a}}", "as": "teller_a"},
    {"save": "orders_list_by_shift", "model": "PaginatedOrders", "method": "GET", "path": "/orders?branch_id={{branch_a}}&shift_id={{s_a}}&page=1&per_page=3", "as": "teller_a"},
    {"save": "orders_get", "model": "OrderFull", "method": "GET", "path": "/orders/{{order_a}}", "as": "teller_a"},
    {"save": "refunds_by_shift_empty", "model": "ShiftRefunds", "clients": ["v0.6.0"], "method": "GET", "path": "/refunds/shift/{{s_a}}", "as": "teller_a"},
    {"save": "reports_shift_summary", "model": "ShiftSummary", "method": "GET", "path": "/reports/shifts/{{s_a}}/summary", "as": "admin"},
    {"save": "reports_shift_deductions", "method": "GET", "path": "/reports/shifts/{{s_a}}/deductions", "as": "admin"},
    {"save": "open_tickets_list", "model": "Vec<OpenTicketView>", "method": "GET", "path": "/open-tickets?branch_id={{branch_b}}", "as": "teller_b"},
    {"save": "open_tickets_get_settled", "model": "OpenTicketView", "method": "GET", "path": "/open-tickets/{{ticket_settled}}", "as": "teller_a"},
    {"save": "delivery_orders_list", "model": "Vec<DeliveryOrder>", "method": "GET", "path": "/delivery-orders?branch_id={{branch_b}}&limit=5", "as": "teller_b"},

    {"save": "replay_cash_movement", "model": "CashMovement", "method": "POST", "path": "/sync/replay", "as": "teller_a",
     "body": {"op": "cash_movement", "teller_id": "{{teller_a}}", "shift_id": "{{s_a}}",
              "request": {"amount": -1500, "note": "golden pay out", "client_ref": "{{cm_ref}}", "kind": "pay_out"}}},
    {"save": "replay_cash_movement_dedup", "model": "CashMovement", "method": "POST", "path": "/sync/replay", "as": "teller_a",
     "body": {"op": "cash_movement", "teller_id": "{{teller_a}}", "shift_id": "{{s_a}}",
              "request": {"amount": -1500, "note": "golden pay out", "client_ref": "{{cm_ref}}", "kind": "pay_out"}}},
    {"save": "replay_create_order", "model": "ReplayCreateOrderAck", "method": "POST", "path": "/sync/replay", "as": "teller_a", "bind": {"new_order": "id"},
     "body": {"op": "create_order", "teller_id": "{{teller_a}}", "request": {
              "branch_id": "{{branch_a}}", "shift_id": "{{s_a}}", "payment_method": "cash", "idempotency_key": "{{key_replay}}",
              "items": [{"menu_item_id": "{{item}}", "quantity": 1, "unit_price": 5000, "addons": [], "optional_field_ids": []}],
              "subtotal": 5000, "tax_amount": 0, "total_amount": 5000, "amount_tendered": 5000, "change_given": 0}}},
    {"save": "orders_get_created", "model": "OrderFull", "method": "GET", "path": "/orders/{{new_order}}", "as": "teller_a"},
    {"save": "replay_refund_order", "model": "RefundIssued", "clients": ["v0.6.0"], "method": "POST", "path": "/sync/replay", "as": "teller_a",
     "body": {"op": "refund_order", "teller_id": "{{teller_a}}", "request": {
              "order_id": "{{new_order}}", "amount": 1000, "method": "cash", "reason": "quality_issue",
              "client_ref": "{{refund_ref}}", "shift_id": "{{s_a}}"}}},
    {"save": "replay_refund_order_dedup", "model": "RefundIssued", "clients": ["v0.6.0"], "method": "POST", "path": "/sync/replay", "as": "teller_a",
     "body": {"op": "refund_order", "teller_id": "{{teller_a}}", "request": {
              "order_id": "{{new_order}}", "amount": 1000, "method": "cash", "reason": "quality_issue",
              "client_ref": "{{refund_ref}}", "shift_id": "{{s_a}}"}}},
    {"save": "refunds_by_order", "model": "OrderRefunds", "clients": ["v0.6.0"], "method": "GET", "path": "/refunds/order/{{new_order}}", "as": "teller_a"},
    {"save": "refunds_by_shift", "model": "ShiftRefunds", "clients": ["v0.6.0"], "method": "GET", "path": "/refunds/shift/{{s_a}}", "as": "teller_a"},
    {"save": "orders_list_by_shift_after", "model": "PaginatedOrders", "method": "GET", "path": "/orders?branch_id={{branch_a}}&shift_id={{s_a}}&page=1&per_page=2", "as": "teller_a"},
    {"save": "replay_settle_open_ticket", "model": "Order", "method": "POST", "path": "/sync/replay", "as": "teller_b",
     "body": {"op": "settle_open_ticket", "teller_id": "{{teller_b}}", "ticket_id": "{{ticket_open}}",
              "request": {"payment_method": "card", "shift_id": "{{s_b}}"}}},
    {"save": "open_tickets_get_just_settled", "model": "OpenTicketView", "method": "GET", "path": "/open-tickets/{{ticket_open}}", "as": "teller_b"},
    {"save": "delivery_finalize", "model": "FinalizeResponse", "method": "POST", "path": "/delivery-orders/{{delivery}}/finalize", "as": "teller_b",
     "body": {"payment_method": "cash", "shift_id": "{{s_b}}"}},
    {"save": "replay_void_order", "method": "POST", "path": "/sync/replay", "as": "teller_a",
     "body": {"op": "void_order", "teller_id": "{{teller_a}}", "order_id": "{{order_b}}",
              "request": {"reason": "customer_request", "note": "golden void"}}},
    {"save": "replay_void_order_again", "method": "POST", "path": "/sync/replay", "as": "teller_a",
     "body": {"op": "void_order", "teller_id": "{{teller_a}}", "order_id": "{{order_b}}",
              "request": {"reason": "customer_request", "note": "golden void"}}},
    {"save": "orders_get_voided", "model": "OrderFull", "method": "GET", "path": "/orders/{{order_b}}", "as": "teller_a"},
    {"save": "shifts_report_after_mutations", "model": "ShiftReportResponse", "method": "GET", "path": "/shifts/{{s_a}}/report", "as": "teller_a"},
    {"save": "replay_close_shift", "model": "CloseShiftResponse", "method": "POST", "path": "/sync/replay", "as": "teller_a",
     "body": {"op": "close_shift", "teller_id": "{{teller_a}}", "shift_id": "{{s_a}}",
              "request": {"closing_cash_declared": 10000, "cash_note": null}}},
    {"save": "replay_close_shift_again", "model": "CloseShiftResponse", "method": "POST", "path": "/sync/replay", "as": "teller_a",
     "body": {"op": "close_shift", "teller_id": "{{teller_a}}", "shift_id": "{{s_a}}",
              "request": {"closing_cash_declared": 10000, "cash_note": null}}},
    {"save": "shifts_current_after_close", "model": "ShiftPreFill", "method": "GET", "path": "/shifts/branches/{{branch_a}}/current", "as": "teller_a"},
    {"save": "replay_open_shift", "model": "Shift", "method": "POST", "path": "/sync/replay", "as": "teller_a",
     "body": {"op": "open_shift", "teller_id": "{{teller_a}}", "branch_id": "{{branch_a}}",
              "request": {"id": "{{s_new}}", "opening_cash": 10000}}},
    {"save": "replay_open_shift_dedup", "model": "Shift", "method": "POST", "path": "/sync/replay", "as": "teller_a",
     "body": {"op": "open_shift", "teller_id": "{{teller_a}}", "branch_id": "{{branch_a}}",
              "request": {"id": "{{s_new}}", "opening_cash": 10000}}},
    {"save": "shifts_force_close", "model": "Shift", "clients": ["v0.6.0"], "method": "POST", "path": "/shifts/{{s_force}}/force-close", "as": "admin",
     "body": {"reason": "golden capture"}}
  ]
}
