  "db_name": "PostgreSQL",
  "query": "\n        SELECT l.id, l.refund_id, l.order_item_id, i.item_name, l.quantity, l.amount, l.restock\n        FROM order_refund_lines l\n        JOIN order_items i ON i.id = l.order_item_id\n        WHERE l.refund_id = ANY($1)\n        ORDER BY l.id\n        ",
