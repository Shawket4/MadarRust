/target
db-backups/
.DS_Store
node_modules/
*.env
# ...and the variants that slip past it. `madar.env.redacted` was NOT redacted:
# it carried a live JWT_SECRET, a DATABASE_URL with credentials and an API key.
# A name is not a guarantee.
*.env.*
madar.env*
package-lock.json
INVENTORY_OVERHAUL_FRONTEND_SYNC.md

# Robustness tooling artifacts
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz-out/
/.fuzzvenv/
/mutants.out*/
/restler_work/

# Local dev container data (OSRM map files, Shlink DB, WhatsApp sessions)
/dev-data/

# Runtime upload artifacts (user-uploaded logos/images)
/uploads/

# Load-test run artifacts
/loadtest/results/

# Local agent/tooling scratch directories
.claude/
.ua/

# Database dumps never belong in git (the repo is public).
*.dump
/full_dump.sql
/*_dump*.sql

# Rust build output of the authz tooling crates (committed by mistake once)
/authz/gen/target/
/authz/crate/target/

# PGP / integration secrets — never in git.
# The Talabat private key lives OUTSIDE any repo, in ~/.talabat-pgp (see
# Madar/TALABAT_INTEGRATION.md). These patterns are the second lock.
*.asc
*.gpg
*.pgp
*.key
*.pem
*.p12
secring.*
openpgp-revocs.d/
.talabat-pgp/

# Customer menu drops: real business data (menus, prices, stock levels) and
# the cleaned imports built from them. Kept locally, never committed.
/drops/
/drops_clean/

# Firebase / FCM credentials — the server key lives outside the repo (see
# FCM_SERVICE_ACCOUNT_FILE in .env.example). These patterns are the second lock.
*firebase-adminsdk*.json
*service-account*.json
**/AuthKey_*.p8
