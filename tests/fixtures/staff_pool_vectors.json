{
  "_comment": [
    "The staff drinks pool's rule, written down once and executed on both sides.",
    "Committed to BOTH MadarRust (tests/fixtures/) and madar/rust-core/crates/madar-core/tests/fixtures/.",
    "These are hand-authored expectations, not a recording: they are the specification.",
    "If you change the rule, change it here first and let both repos' tests fail until they agree.",
    "Executed by MadarRust src/staff_pool/vectors_tests.rs and madar-core tests/staff_pool_vectors.rs."
  ],
  "cases": [
    {
      "name": "inside the allowance",
      "settings": { "enabled": true, "daily_allowance": 5, "eligible_item_ids": ["latte"] },
      "business_date": "2026-09-19", "item_id": "latte", "note": "for Sara, closing shift", "used": 2,
      "expect": { "allowed": true, "refusal": null, "overspent": false,
                  "pool": { "business_date": "2026-09-19", "allowance": 5, "used": 3, "remaining": 2, "over": 0 } }
    },
    {
      "name": "the drink that exactly fills the allowance is not an overspend",
      "settings": { "enabled": true, "daily_allowance": 5, "eligible_item_ids": ["latte"] },
      "business_date": "2026-09-19", "item_id": "latte", "note": "Omar", "used": 4,
      "expect": { "allowed": true, "refusal": null, "overspent": false,
                  "pool": { "business_date": "2026-09-19", "allowance": 5, "used": 5, "remaining": 0, "over": 0 } }
    },
    {
      "name": "the first drink past the allowance lands and is marked",
      "settings": { "enabled": true, "daily_allowance": 5, "eligible_item_ids": ["latte"] },
      "business_date": "2026-09-19", "item_id": "latte", "note": "Omar", "used": 5,
      "expect": { "allowed": true, "refusal": null, "overspent": true,
                  "pool": { "business_date": "2026-09-19", "allowance": 5, "used": 6, "remaining": 0, "over": 1 } }
    },
    {
      "name": "far past the allowance is still allowed",
      "settings": { "enabled": true, "daily_allowance": 3, "eligible_item_ids": ["latte"] },
      "business_date": "2026-09-19", "item_id": "latte", "note": "the whole morning shift", "used": 11,
      "expect": { "allowed": true, "refusal": null, "overspent": true,
                  "pool": { "business_date": "2026-09-19", "allowance": 3, "used": 12, "remaining": 0, "over": 9 } }
    },
    {
      "name": "an allowance of zero makes the first drink an overspend, and refuses nothing",
      "settings": { "enabled": true, "daily_allowance": 0, "eligible_item_ids": ["latte"] },
      "business_date": "2026-09-19", "item_id": "latte", "note": "Sara", "used": 0,
      "expect": { "allowed": true, "refusal": null, "overspent": true,
                  "pool": { "business_date": "2026-09-19", "allowance": 0, "used": 1, "remaining": 0, "over": 1 } }
    },
    {
      "name": "a fresh business day is simply a used count of zero",
      "settings": { "enabled": true, "daily_allowance": 3, "eligible_item_ids": ["latte"] },
      "business_date": "2026-09-20", "item_id": "latte", "note": "Sara", "used": 0,
      "expect": { "allowed": true, "refusal": null, "overspent": false,
                  "pool": { "business_date": "2026-09-20", "allowance": 3, "used": 1, "remaining": 2, "over": 0 } }
    },
    {
      "name": "no note is a refusal",
      "settings": { "enabled": true, "daily_allowance": 5, "eligible_item_ids": ["latte"] },
      "business_date": "2026-09-19", "item_id": "latte", "note": "", "used": 1,
      "expect": { "allowed": false, "refusal": "note_required", "overspent": false,
                  "pool": { "business_date": "2026-09-19", "allowance": 5, "used": 1, "remaining": 4, "over": 0 } }
    },
    {
      "name": "whitespace is not a note",
      "settings": { "enabled": true, "daily_allowance": 5, "eligible_item_ids": ["latte"] },
      "business_date": "2026-09-19", "item_id": "latte", "note": "   \t\n ", "used": 1,
      "expect": { "allowed": false, "refusal": "note_required", "overspent": false,
                  "pool": { "business_date": "2026-09-19", "allowance": 5, "used": 1, "remaining": 4, "over": 0 } }
    },
    {
      "name": "a note is trimmed, not rejected, when it has real content",
      "settings": { "enabled": true, "daily_allowance": 5, "eligible_item_ids": ["latte"] },
      "business_date": "2026-09-19", "item_id": "latte", "note": "  Sara  ", "used": 0,
      "expect": { "allowed": true, "refusal": null, "overspent": false,
                  "pool": { "business_date": "2026-09-19", "allowance": 5, "used": 1, "remaining": 4, "over": 0 } }
    },
    {
      "name": "an item off the list never counts",
      "settings": { "enabled": true, "daily_allowance": 5, "eligible_item_ids": ["latte", "tea"] },
      "business_date": "2026-09-19", "item_id": "cheesecake", "note": "Sara", "used": 0,
      "expect": { "allowed": false, "refusal": "item_not_eligible", "overspent": false,
                  "pool": { "business_date": "2026-09-19", "allowance": 5, "used": 0, "remaining": 5, "over": 0 } }
    },
    {
      "name": "an empty eligible list is a pool that is off",
      "settings": { "enabled": true, "daily_allowance": 5, "eligible_item_ids": [] },
      "business_date": "2026-09-19", "item_id": "latte", "note": "Sara", "used": 0,
      "expect": { "allowed": false, "refusal": "no_eligible_items", "overspent": false,
                  "pool": { "business_date": "2026-09-19", "allowance": 5, "used": 0, "remaining": 5, "over": 0 } }
    },
    {
      "name": "the master switch is checked before everything else",
      "settings": { "enabled": false, "daily_allowance": 0, "eligible_item_ids": [] },
      "business_date": "2026-09-19", "item_id": "nope", "note": "", "used": 0,
      "expect": { "allowed": false, "refusal": "pool_off", "overspent": false,
                  "pool": { "business_date": "2026-09-19", "allowance": 0, "used": 0, "remaining": 0, "over": 0 } }
    },
    {
      "name": "an off pool is refused even when everything else is right",
      "settings": { "enabled": false, "daily_allowance": 5, "eligible_item_ids": ["latte"] },
      "business_date": "2026-09-19", "item_id": "latte", "note": "Sara", "used": 0,
      "expect": { "allowed": false, "refusal": "pool_off", "overspent": false,
                  "pool": { "business_date": "2026-09-19", "allowance": 5, "used": 0, "remaining": 5, "over": 0 } }
    }
  ],
  "business_date_cases": [
    { "name": "Cairo: late evening UTC is already tomorrow at the branch",
      "tz": "Africa/Cairo", "at": "2026-09-19T22:30:00Z", "expect": "2026-09-20" },
    { "name": "Cairo: the exact instant local midnight falls",
      "tz": "Africa/Cairo", "at": "2026-09-19T21:00:00Z", "expect": "2026-09-20" },
    { "name": "Cairo: one second before local midnight is still the old day",
      "tz": "Africa/Cairo", "at": "2026-09-19T20:59:59Z", "expect": "2026-09-19" },
    { "name": "Cairo: UTC midnight is NOT the reset — the branch is 3 hours in",
      "tz": "Africa/Cairo", "at": "2026-09-20T00:00:00Z", "expect": "2026-09-20" },
    { "name": "Cairo: mid-afternoon",
      "tz": "Africa/Cairo", "at": "2026-09-19T12:00:00Z", "expect": "2026-09-19" },
    { "name": "London: a branch west of Cairo draws its own boundary",
      "tz": "Europe/London", "at": "2026-09-19T22:30:00Z", "expect": "2026-09-19" },
    { "name": "London: past local midnight",
      "tz": "Europe/London", "at": "2026-09-19T23:30:00Z", "expect": "2026-09-20" }
  ]
}
